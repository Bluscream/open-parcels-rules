{
  "$id": "https://raw.githubusercontent.com/Bluscream/open-parcels-rules/main/schema/keys.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Carrier id from carriers.yaml."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "What the consumer asks for, unique per carrier, e.g. api_key."
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "description": "Where the carrier expects the value and why."
          },
          "source": {
            "type": "string",
            "enum": [
              "website",
              "app"
            ],
            "description": "Where the value was read from: the public website or the carrier's app."
          },
          "last_verified": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Date the value was last seen working."
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "carrier",
          "name",
          "purpose",
          "source",
          "last_verified",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "keys"
  ],
  "additionalProperties": false,
  "description": "Fixed public values carriers expect from every client (website or app keys, client ids, app versions, User-Agents). Never a user's credentials."
}
