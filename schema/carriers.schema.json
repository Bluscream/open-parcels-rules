{
  "$id": "https://raw.githubusercontent.com/Bluscream/open-parcels-rules/main/schema/carriers.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "carriers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Lower-case identifier: letters, digits, '_' and '-'."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "countries": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2 country code."
            }
          },
          "domains": {
            "default": [],
            "description": "Domains the carrier sends mail from or hosts tracking pages on.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
              "description": "A mail or web domain; subdomains match too."
            }
          },
          "courier_codes": {
            "default": [],
            "description": "courier_code values of tracking-number files whose formats belong to this carrier (the carrier's own id is implied).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "upu_countries": {
            "default": [],
            "description": "Countries whose UPU S10 numbers (e.g. RR123456785DE) this carrier delivers.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2 country code."
            }
          },
          "tracking_urls": {
            "default": {},
            "description": "Tracking page templates keyed by locale ('default', a language such as 'de', or a full tag such as 'de-AT'). {tracking_number} is replaced by the URL-encoded number.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^https:\\/\\/\\S*\\{tracking_number\\}\\S*$"
            }
          },
          "crossref": {
            "default": {},
            "description": "Identifiers of this carrier in other systems, e.g. 17track: '100001'.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "carriers"
  ],
  "additionalProperties": false
}
