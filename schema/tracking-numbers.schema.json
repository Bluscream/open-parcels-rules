{
  "$id": "https://raw.githubusercontent.com/Bluscream/open-parcels-rules/main/schema/tracking-numbers.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "courier_code": {
      "type": "string"
    },
    "tracking_numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "regex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Whitespace-tolerant pattern; an array is joined into one pattern. Named groups SerialNumber and CheckDigit feed the checksum."
          },
          "validation": {
            "type": "object",
            "properties": {
              "checksum": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "const": "mod10"
                      },
                      "modulo": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "evens_multiplier": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "odds_multiplier": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "reverse": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "const": "mod7"
                      },
                      "modulo": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "const": "s10"
                      },
                      "weightings": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "modulo": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "const": "luhn"
                      },
                      "modulo": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "const": "mod_37_36"
                      },
                      "modulo": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "alphabet": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "const": "sum_product_with_weightings_and_modulo"
                      },
                      "weightings": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "modulo1": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "modulo2": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "name",
                      "weightings",
                      "modulo1",
                      "modulo2"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "serial_number_format": {
                "type": "object",
                "properties": {
                  "prepend_if": {
                    "type": "object",
                    "properties": {
                      "matches_regex": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "matches_regex",
                      "content"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "prepend_if"
                ],
                "additionalProperties": false
              },
              "additional": {
                "type": "object",
                "properties": {
                  "exists": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Names of `additional` lookups that must find a row for the number to be valid."
                  }
                },
                "required": [
                  "exists"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "tracking_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "glossary": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "description"
              ],
              "additionalProperties": false
            }
          },
          "test_numbers": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "invalid": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "valid",
              "invalid"
            ],
            "additionalProperties": false
          },
          "additional": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "regex_group_name": {
                  "type": "string"
                },
                "lookup": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": "One row of an additional lookup: `matches` (exact) or `matches_regex` (whole value), plus descriptive string fields such as name, description, country or courier."
                  }
                }
              },
              "required": [
                "name",
                "regex_group_name",
                "lookup"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "regex",
          "validation",
          "test_numbers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "courier_code",
    "tracking_numbers"
  ],
  "additionalProperties": false
}
